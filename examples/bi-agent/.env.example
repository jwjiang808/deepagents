ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Or use OpenAI:
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: database connection string (defaults to in-memory SQLite demo)
# DATABASE_URL=sqlite:///./bi_demo.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# Optional: model override (defaults to anthropic:claude-sonnet-4-6)
# BI_AGENT_MODEL=openai:gpt-4o
